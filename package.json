{
  "name": "isaa-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "start": "node src/index.js",
    "seed": "node --env-file-if-exists=.env src/seed/seed.js",
    "seed:fresh": "node --env-file-if-exists=.env src/seed/seed.js --fresh",
    "seed:new": "node --env-file-if-exists=.env src/seed/seed.js --new",
    "seed:all": "node --env-file-if-exists=.env src/seed/seed-all.js",
    "seed:all:check": "node --env-file-if-exists=.env src/seed/seed-all.js --dry",
    "seed:descriptions": "node --env-file-if-exists=.env src/seed/update-descriptions.js",
    "seed:descriptions:check": "node --env-file-if-exists=.env src/seed/update-descriptions.js --dry",
    "migrate:heroes": "node --env-file-if-exists=.env src/scripts/migrate-color-heroes.js",
    "seed:check": "node --env-file-if-exists=.env src/seed/seed.js --dry",
    "check:deploy": "node scripts/check-deploy.mjs",
    "admin:create": "node --env-file-if-exists=.env src/scripts/admin.js create",
    "admin:password": "node --env-file-if-exists=.env src/scripts/admin.js password",
    "admin:list": "node --env-file-if-exists=.env src/scripts/admin.js list",
    "admin:unlock": "node --env-file-if-exists=.env src/scripts/admin.js unlock",
    "admin:disable": "node --env-file-if-exists=.env src/scripts/admin.js disable",
    "test": "node --test test/*.test.js",
    "test:integration": "node --test --test-concurrency=2 test/integration/*.test.js",
    "test:all": "npm test && npm run test:integration"
  },
  "dependencies": {
    "cloudinary": "^2.11.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "mongoose": "^9.12.2",
    "morgan": "^1.12.1",
    "nodemailer": "^10.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.4.0",
    "supertest": "^7.3.2"
  }
}
